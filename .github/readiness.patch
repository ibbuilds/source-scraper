diff --git a/scripts/release-policy.mjs b/scripts/release-policy.mjs
new file mode 100644
index 0000000..d55cf88
--- /dev/null
+++ b/scripts/release-policy.mjs
@@ -0,0 +1,13 @@
+/** Immutable release decisions, shared by CI and offline regression tests. */
+export function releasePlan({testedSha, mainSha, tagSha = null, releaseExists = false}) {
+  for (const [label, value] of Object.entries({testedSha, mainSha, ...(tagSha ? {tagSha} : {})})) {
+    if (typeof value !== 'string' || !/^[a-f0-9]{40}$/.test(value)) throw Error(`Invalid ${label}`);
+  }
+  if (releaseExists && !tagSha) throw Error('Release exists without its tag');
+  if (mainSha !== testedSha) return {publish:false, reason:'A newer main commit must pass CI first'};
+  if (tagSha && tagSha !== testedSha) {
+    if (!releaseExists) throw Error('Existing tag differs from the tested commit; choose a new version');
+    return {publish:false, reason:'Published version is immutable; increment the version for a new release'};
+  }
+  return {publish:!releaseExists, reason:releaseExists ? 'This tested commit is already published' : 'Publish the tested commit'};
+}
diff --git a/tests/release-policy.test.ts b/tests/release-policy.test.ts
new file mode 100644
index 0000000..96719e9
--- /dev/null
+++ b/tests/release-policy.test.ts
@@ -0,0 +1,15 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+// @ts-ignore The deployment helper is intentionally plain Node.js.
+import {releasePlan} from '../scripts/release-policy.mjs';
+const a='a'.repeat(40), b='b'.repeat(40);
+test('release policy never moves a published tag or fails maintenance on an unchanged version',()=>{
+ assert.equal(releasePlan({testedSha:a,mainSha:a}).publish,true);
+ assert.equal(releasePlan({testedSha:a,mainSha:b}).publish,false);
+ assert.equal(releasePlan({testedSha:a,mainSha:a,tagSha:a,releaseExists:true}).publish,false);
+ assert.equal(releasePlan({testedSha:a,mainSha:a,tagSha:b,releaseExists:true}).publish,false);
+ assert.equal(releasePlan({testedSha:a,mainSha:a,tagSha:a,releaseExists:false}).publish,true);
+ assert.throws(()=>releasePlan({testedSha:a,mainSha:a,tagSha:b}),/new version/);
+ assert.throws(()=>releasePlan({testedSha:a,mainSha:a,releaseExists:true}),/without its tag/);
+ assert.throws(()=>releasePlan({testedSha:'main',mainSha:a}),/Invalid/);
+});
